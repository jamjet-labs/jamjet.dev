---
import { currentReleases } from '../data/releases';

const releases = await currentReleases();
---
<p class="releases">
  <span class="releases-label">Current releases</span>
  {releases.map((r) => (
    <a class="releases-item" href={r.href} target="_blank" rel="noopener" title={`${r.pkg} on ${r.registry}`}>
      {r.label} <code>{r.version}</code>
    </a>
  ))}
</p>

<style>
  .releases {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 16px;
    margin: 0 0 12px;
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--text-secondary);
  }
  .releases-label {
    font-size: 12.5px;
    color: var(--text-muted);
  }
  .releases-item {
    color: var(--text-secondary);
    text-decoration: none;
    border-bottom: 1px dashed var(--border-strong);
  }
  .releases-item:hover { color: var(--text); }
  .releases-item code {
    font-family: var(--font-mono);
    font-size: 12px;
    background: var(--accent-bg);
    padding: 1px 5px;
    border-radius: 3px;
  }
</style>
